{{!--
  비밀번호 재설정(resetPassword) 메일 본문 — render_mail.ts 가 렌더한다.
  문구는 copy.json 의 mail.resetPassword.* · mail.fallback · mail.footer 이고 여기서 고치지 않는다.
  치환 값은 escape 가 끝난 조각이라 triple-stash 로 넣는다(링크 · 로고 URL 포함 — = 가 &#x3D; 로 바뀌지 않게).
  스타일은 전부 inline 이다 — style 블록 · 외부 CSS · 웹 폰트 · 추적 픽셀을 넣지 않는다.
--~}}
<!doctype html>
<html lang="{{lang}}"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="color-scheme" content="light"><meta name="supported-color-schemes" content="light">
<title>{{{subject}}}</title></head>
<body style="margin:0;padding:0;background:#FFFFFF;">
<div style="display:none;max-height:0;overflow:hidden;opacity:0;">{{{preheader}}}</div>
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background:#FFFFFF;">
<tr><td align="center" style="padding:32px 24px;">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="max-width:560px;font-family:{{{fontFamily}}};color:#1F1F1F;{{{keepAll}}}">
<tr><td style="padding:0 0 32px;">{{#if logoUrl}}<img src="{{{logoUrl}}}" alt="{{{appName}}}" height="40" style="display:block;height:40px;width:auto;max-width:160px;border:0;">{{else}}<span style="font-size:20px;line-height:1.2;font-weight:700;color:#1F1F1F;">{{{appName}}}</span>{{/if}}</td></tr>
<tr><td style="font-size:24px;line-height:1.3;font-weight:700;padding:0 0 16px;">{{{heading}}}</td></tr>
<tr><td style="font-size:16px;line-height:1.5;padding:0 0 32px;">{{{body}}}</td></tr>
<tr><td style="padding:0 0 32px;">
  <table role="presentation" cellpadding="0" cellspacing="0" border="0"><tr>
  <td bgcolor="{{{brandColor}}}" style="border-radius:24px;">
    <a href="{{{link}}}" target="_blank" style="display:inline-block;padding:12px 24px;font-size:16px;line-height:24px;font-weight:700;color:{{{onBrandColor}}};text-decoration:none;border-radius:24px;font-family:{{{fontFamily}}};">{{{button}}}</a>
  </td></tr></table>
</td></tr>
<tr><td style="font-size:14px;line-height:1.4;color:#5F6368;padding:0 0 24px;">{{{ignore}}}</td></tr>
<tr><td style="border-top:1px solid #E0E0E0;padding:24px 0 0;font-size:14px;line-height:1.4;color:#5F6368;">{{{fallback}}}<br>
<a href="{{{link}}}" style="color:#1F1F1F;text-decoration:underline;word-break:break-all;">{{{link}}}</a></td></tr>
<tr><td style="font-size:14px;line-height:1.4;color:#5F6368;padding:24px 0 0;">{{{footer}}}</td></tr>
</table>
</td></tr></table>
</body></html>
