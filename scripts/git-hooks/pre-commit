#!/bin/bash
# git pre-commit hook wrapper.
# 활성화: docs/manual.md "## Git Hooks 활성화 (선택)" 참조.
#
# 가드 1 — FlutterFire CLI 가 생성한 실제 Firebase 옵션 파일 커밋 차단.
#   firebase_options_*.dart 3종은 placeholder 로 tracked 되어 있으므로
#   (.gitignore 예외), 실제 키가 든 재생성본이 staged 되면 그대로 커밋된다.
#   index 내용에 FlutterFire CLI 생성 마커가 있으면 커밋을 거부한다.
# 가드 2 — Android google-services.json placeholder 값 검사.
#   android/app/src/{stg,prod}/google-services.json 2종도 placeholder 로
#   tracked 되어 있다 (.gitignore 예외). JSON 은 주석을 지원하지 않아 가드 1 의
#   마커 방식을 쓸 수 없으므로 **값**으로 판정한다 — 실제 Google API 키 접두사가
#   있거나 placeholder project_number 가 사라졌으면 커밋을 거부한다.
# 가드 3 — check_phase_refs.sh (Phase 참조 + TODO 진실원 양방향 lint).

set -uo pipefail

MARKER='File generated by FlutterFire CLI'
# Google API 키 접두사 — placeholder 에 등장하면 실 키 재생성본이다.
GOOGLE_API_KEY_PREFIX='AIza'
# placeholder project_number 라인 (고정 문자열 — 정규식·jq 의존 금지).
PLACEHOLDER_PROJECT_NUMBER='"project_number": "000000000000"'
BLOCKED=0

# bash 3.2 호환: mapfile 미사용, while read 루프로 staged 경로 순회.
while IFS= read -r path; do
  [ -z "$path" ] && continue
  if git show ":$path" 2>/dev/null | grep -qF "$MARKER"; then
    echo "[BLOCK] $path — FlutterFire CLI 생성본이 staged 되었습니다."
    BLOCKED=1
  fi
done < <(git diff --cached --name-only --diff-filter=ACM -- 'lib/core/firebase/firebase_options_*.dart')

# 가드 2 — Android placeholder 값 검사. pathspec 은 tracked placeholder 2경로로
# 한정한다 (dev / app 루트 google-services.json 은 gitignored 라 대상 아님).
while IFS= read -r path; do
  [ -z "$path" ] && continue
  staged_content="$(git show ":$path" 2>/dev/null)"
  if printf '%s' "$staged_content" | grep -qF "$GOOGLE_API_KEY_PREFIX"; then
    echo "[BLOCK] $path — 실제 Google API 키가 staged 되었습니다."
    BLOCKED=1
  elif ! printf '%s' "$staged_content" | grep -qF "$PLACEHOLDER_PROJECT_NUMBER"; then
    echo "[BLOCK] $path — placeholder project_number 가 사라졌습니다 (실제 Firebase 프로젝트 재생성본으로 보입니다)."
    BLOCKED=1
  fi
done < <(git diff --cached --name-only --diff-filter=ACM -- 'android/app/src/stg/google-services.json' 'android/app/src/prod/google-services.json')

if [ "$BLOCKED" -ne 0 ]; then
  cat <<'MSG'

실제 Firebase 키가 repo 에 커밋되려 합니다. 다음 절차로 해제하세요.

  1) git restore --staged <path>
  2) git update-index --skip-worktree <path>
     (./scripts/firebase-configure.sh 가 자동 적용하지만, 수동 생성 시 누락될
      수 있습니다)

placeholder 자체를 의도적으로 수정하려면:
  - firebase_options_*.dart → FlutterFire CLI 생성 마커 주석을 제거한 뒤 커밋
  - android/app/src/{stg,prod}/google-services.json → placeholder 어휘
    ("project_number": "000000000000") 를 유지하고 실제 API 키를 제거한 뒤 커밋
MSG
  exit 1
fi

exec ./scripts/check_phase_refs.sh
