# ==========================
# OS
# ==========================
.DS_Store
*.swp
Thumbs.db

# ==========================
# IDE
# ==========================
*.iml
*.ipr
*.iws
.idea/

# VS Code - launch.json, settings.json 공유 목적으로 커밋 허용
# 필요 시 주석 해제
#.vscode/

# ==========================
# Flutter / Dart
# ==========================
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
**/doc/api/
**/ios/Flutter/.last_build_id
.pub-cache/
.pub/
/build/
/coverage/

# 코드 생성 파일 (Freezed, Riverpod Generator, JSON Serializable)
*.g.dart
*.freezed.dart

# ==========================
# FVM
# ==========================
.fvm/

# ==========================
# Firebase
# ==========================
# FlutterFire CLI 생성 파일 (flutterfire configure로 재생성)
lib/firebase_options*.dart
lib/core/firebase/firebase_options_*.dart

# Firebase 디버그 로그
firebase-debug.log
firebase-debug.*.log

# Firebase 프로젝트 설정
# - firebase.json: Phase 11 부터 functions 블록을 포함하므로 commit 대상 (flutter 블록은
#   flutterfire configure 가 재생성하지만, 신규 사용자는 본인 projectId 로 덮어쓰면 됨)
# - .firebaserc: Phase 11 부터 firebase deploy / emulator 호출에 필요한 dev 프로젝트 alias
#   를 starter kit 기본값으로 commit (다른 프로젝트는 firebase use --add 로 추가)

# Firebase 캐시
.firebase/

# ==========================
# Cloud Functions (functions/)
# ==========================
functions/node_modules/
functions/lib/
functions/.env
functions/.env.*

# ==========================
# 환경 설정 / 시크릿
# ==========================
# Flavor별 dart-define 파일 (API 키 포함 가능)
env/
*.env
.env.*

# Flavor 설정 파일 (실제 시크릿 포함, 로컬 전용 — *.example.json 만 tracked)
# config/dev.json, config/stg.json, config/prod.json 은 fork 사용자가 본인 키로
# 채워넣는 로컬 파일. *.example.json 을 복사해서 사용 (docs/manual.md Initial Setup 참조).
config/*.json
!config/*.example.json

# 키스토어 / 서명
*.jks
*.keystore
*.p8
key.properties

# ==========================
# Android
# ==========================
/android/app/debug
/android/app/profile
/android/app/release
/android/.gradle/
/android/.cxx/
/android/local.properties

# Firebase Android 설정 (flavor별 flutterfire configure로 재생성)
**/android/app/google-services.json
**/android/app/src/*/google-services.json

# ==========================
# iOS
# ==========================
**/ios/Pods/
**/ios/.symlinks/
**/ios/Flutter/Flutter.framework
**/ios/Flutter/Flutter.podspec
**/xcuserdata/
**/DerivedData/

# Firebase iOS 설정 (flavor별 flutterfire configure로 재생성)
**/ios/Runner/GoogleService-Info.plist
**/ios/firebase_app_id_file.json

# ==========================
# macOS
# ==========================
**/macos/Flutter/ephemeral/
**/macos/Pods/

# ==========================
# Linux
# ==========================
**/linux/flutter/ephemeral/

# ==========================
# Windows
# ==========================
**/windows/flutter/ephemeral/

# ==========================
# Symbolication / Obfuscation
# ==========================
app.*.symbols
app.*.map.json

# ==========================
# Claude Code (로컬 설정만 제외, 나머지는 커밋)
# ==========================
.claude/settings.local.json

# ==========================
# GSD (Get Shit Done) 내부 상태
# ==========================
.planning/.next-call-count

# ==========================
# 기타
# ==========================
*.class
*.log
*.pyc
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/
