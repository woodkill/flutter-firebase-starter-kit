#.vscode/

# ==========================
# Flutter / Dart
# ==========================
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
**/doc/api/
**/ios/Flutter/.last_build_id
.pub-cache/
.pub/
/build/
/coverage/

# 코드 생성 파일 (Freezed, Riverpod Generator, JSON Serializable)
*.g.dart
*.freezed.dart

# ==========================
# FVM
# ==========================
.fvm/

# ==========================
# Firebase
# ==========================
# FlutterFire CLI 생성 파일 (flutterfire configure로 재생성)
lib/firebase_options*.dart
lib/core/firebase/firebase_options_*.dart

# Firebase 디버그 로그
firebase-debug.log
firebase-debug.*.log

# Firebase 캐시/배포
.firebase/
.firebaserc

# ==========================
