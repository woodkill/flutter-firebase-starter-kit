# OS
# ==========================
.DS_Store
*.swp
Thumbs.db

# ==========================
# IDE
# ==========================
*.iml
*.ipr
*.iws
.idea/

# VS Code - launch.json, settings.json 공유 목적으로 커밋 허용
# 필요 시 주석 해제
#.vscode/

# ==========================
# Flutter / Dart
# ==========================
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
**/doc/api/
**/ios/Flutter/.last_build_id
.pub-cache/
.pub/
/build/
/coverage/

# 코드 생성 파일 (Freezed, Riverpod Generator, JSON Serializable)
*.g.dart
*.freezed.dart

# Golden test 실패 시 자동 생성되는 diff 이미지 (test 산출물, commit 금지)
# *.{isolatedDiff, maskedDiff, masterImage, testImage}.png 가 failures/ 하위에 생성됨
**/test/**/failures/

# ==========================
# FVM
# ==========================
.fvm/

# ==========================
# Firebase
# ==========================
# FlutterFire CLI 생성 파일 (flutterfire configure로 재생성)
lib/firebase_options*.dart
lib/core/firebase/firebase_options_*.dart
# 단, 3 flavor placeholder 는 tracked — 이 파일들이 없으면 fresh clone 직후
# firebase_initializer.dart 의 import 가 uri_does_not_exist 로 깨져 analyze
# 게이트가 상시 오염된다. 실제 키가 든 재생성본이 커밋되지 않도록
# firebase-configure.sh 의 skip-worktree + pre-commit hook 이 이중 방어한다.
!lib/core/firebase/firebase_options_dev.dart
!lib/core/firebase/firebase_options_stg.dart
!lib/core/firebase/firebase_options_prod.dart

# Firebase 디버그 로그
firebase-debug.log
firebase-debug.*.log

# Firebase 프로젝트 설정
# - firebase.json: Phase 11 부터 functions 블록을 포함하므로 commit 대상 (flutter 블록은
#   flutterfire configure 가 재생성하지만, 신규 사용자는 본인 projectId 로 덮어쓰면 됨)
# - .firebaserc: Phase 11 부터 firebase deploy / emulator 호출에 필요한 dev 프로젝트 alias
#   를 starter kit 기본값으로 commit (다른 프로젝트는 firebase use --add 로 추가)

# Firebase 캐시
.firebase/

# ==========================
# Cloud Functions (functions/)
# ==========================
functions/node_modules/
functions/lib/
functions/.env
functions/.env.*

# ==========================
# 환경 설정 / 시크릿
# ==========================
# Flavor별 dart-define 파일 (API 키 포함 가능)
env/
*.env
.env.*

# Flavor 설정 파일 (실제 시크릿 포함, 로컬 전용 — *.example.json 만 tracked)
# config/dev.json, config/stg.json, config/prod.json 은 fork 사용자가 본인 키로
# 채워넣는 로컬 파일. *.example.json 을 복사해서 사용 (docs/manual.md Initial Setup 참조).
config/*.json
!config/*.example.json

# iOS Flutter xcconfig (실제 시크릿 포함, 로컬 전용 — *.example.xcconfig 만 tracked)
# ios/Flutter/{dev,stg,prod}.xcconfig 은 fork 사용자가 본인 키로 채워넣는 로컬 파일.
# *.example.xcconfig 을 복사해서 사용 (docs/manual.md "## 0. Initial Setup" 참조).
# 주의: ios/Flutter/*.xcconfig glob 은 Debug-dev/Generated/Debug 등 다른 xcconfig
# 파일도 매칭하므로 explicit 3 라인으로 명시 (config/*.json 패턴과 디렉토리 의미 다름).
ios/Flutter/dev.xcconfig
ios/Flutter/stg.xcconfig
ios/Flutter/prod.xcconfig

# 키스토어 / 서명
*.jks
*.keystore
*.p8
key.properties

