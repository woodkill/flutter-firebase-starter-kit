# ==========================
functions/node_modules/
functions/lib/
functions/.env
functions/.env.*

# ==========================
# 환경 설정 / 시크릿
# ==========================
# Flavor별 dart-define 파일 (API 키 포함 가능)
env/
*.env
.env.*

# 키스토어 / 서명
*.jks
*.keystore
key.properties

