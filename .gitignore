# ==========================
# Claude Code (로컬 설정만 제외, 나머지는 커밋)
# ==========================
.claude/settings.local.json

# ==========================
# GSD (Get Shit Done) 내부 상태
# ==========================
.planning/.next-call-count
# gsd-core 런타임 디렉토리. dispatch isolation sentinel 등 run 단위 상태만 담기며
# 세션·머신 로컬이라 공유 가치가 없다.
.gsd/
# milestone 점유 advisory lock. session-id + pid 바인딩 + TTL 기반이라
# 다른 머신에서는 무의미하다.
.planning/milestone.lock
# STATE.md / ROADMAP.md 에서 파생된 best-effort 스냅샷 캐시. step-boundary 명령마다
# 재발행되어 커밋 churn 만 유발한다. 진실원은 STATE.md 다.
.planning/state.json

# ==========================
# Golden test — dev-only fixtures (라이센스 위험 회피)
# ==========================
# Phase 13.3 Wave 4 Step 3 (2026-05-16) — Apple/Google/Kakao/Naver iOS golden
# fixtures: AppleSDGothicNeo + SF Pro Text (macOS native 시스템 폰트, Apple
# Font License + Sandoll 라이센스) 으로 렌더된 PNG 를 repo distribute 시
# 라이센스 위반 위험. macOS dev 환경에서만 로컬 생성 + 시각 sign-off + commit
# 차단. CI/Linux 환경은 testWidgets `skip` 매개변수로 우회 (Platform.isMacOS
# 게이트).
test/features/auth/presentation/_widgets/goldens/kakao_light_ios.png
test/features/auth/presentation/_widgets/goldens/naver_light_ios.png
test/features/auth/presentation/_widgets/goldens/apple_light_ios.png
test/features/auth/presentation/_widgets/goldens/apple_dark_ios.png
test/features/auth/presentation/_widgets/goldens/google_light_ios.png
test/features/auth/presentation/_widgets/goldens/google_dark_ios.png
test/features/auth/presentation/_widgets/goldens/facebook_light_ios.png
test/features/auth/presentation/_widgets/goldens/facebook_dark_ios.png
# Phase 13.3 X3 (2026-05-17, 260517-uv4) — Kakao/Naver dark iOS variants.
test/features/auth/presentation/_widgets/goldens/kakao_dark_ios.png
test/features/auth/presentation/_widgets/goldens/naver_dark_ios.png

