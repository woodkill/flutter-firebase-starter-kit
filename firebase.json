{
  "flutter": {
    "platforms": {
      "android": {
        "default": {
          "projectId": "slimpumpkin-starter-kit-dev",
          "appId": "1:775174386750:android:557d818eba598dbb160d6f",
          "fileOutput": "android/app/google-services.json"
        }
      },
      "ios": {
        "default": {
          "projectId": "slimpumpkin-starter-kit-dev",
          "appId": "1:775174386750:ios:6ca1fdaf30692358160d6f",
          "uploadDebugSymbols": true,
          "fileOutput": "ios/Runner/GoogleService-Info.plist"
        }
      },
      "dart": {
        "lib/core/firebase/firebase_options_dev.dart": {
          "projectId": "slimpumpkin-starter-kit-dev",
          "configurations": {
            "android": "1:775174386750:android:557d818eba598dbb160d6f",
            "ios": "1:775174386750:ios:6ca1fdaf30692358160d6f",
            "web": "1:775174386750:web:ba6a91ac5ff4efb4160d6f"
          }
        }
      }
    }
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local"
      ],
      "predeploy": [
        "pnpm -C \"$RESOURCE_DIR\" run lint",
        "pnpm -C \"$RESOURCE_DIR\" run build"
      ]
    }
  ],
  "emulators": {
    "functions": {
      "host": "0.0.0.0",
      "port": 5001
    },
    "firestore": {
      "host": "127.0.0.1",
      "port": 8080
    },
    "storage": {
      "host": "127.0.0.1",
      "port": 9199
    },
    "ui": {
      "host": "0.0.0.0",
      "port": 4000,
      "enabled": true
    },
    "singleProjectMode": true
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "hosting": {
    "public": "build/hosting/public",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "predeploy": [
      "node \"$PROJECT_DIR/hosting/build.mjs\" --project \"$GCLOUD_PROJECT\""
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "X-Frame-Options",
            "value": "DENY"
          },
          {
            "key": "Content-Security-Policy",
            "value": "frame-ancestors 'none'"
          },
          {
            "key": "Referrer-Policy",
            "value": "no-referrer"
          },
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          },
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      }
    ]
  },
  "extensions": {
    "firestore-send-email": "firebase/firestore-send-email@0.2.10"
  }
}
