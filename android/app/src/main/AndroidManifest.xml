<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application
        android:label="flutter_starter_kit"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Facebook SDK 설정 (D-06, Phase 9).
             App ID와 Client Token은 build.gradle.kts resValue로 주입된다. -->
        <meta-data
            android:name="com.facebook.sdk.ApplicationId"
            android:value="@string/facebook_app_id"/>
        <meta-data
            android:name="com.facebook.sdk.ClientToken"
            android:value="@string/facebook_client_token"/>

        <!-- Kakao SDK 설정 (Phase 12 D-21).
             Native App Key는 build.gradle.kts manifestPlaceholders로 주입된다.
             Auth Activity (com.kakao.sdk.flutter.auth.AuthCodeHandlerActivity) 자체는
             kakao_flutter_sdk_auth 패키지의 AndroidManifest.xml에서 자동 merge되며,
             URL scheme (kakao${kakaoNativeAppKey}://oauth) intent-filter만 앱 측에서
             등록한다 (앱별 nativeAppKey가 다르므로). -->
        <meta-data
            android:name="com.kakao.sdk.AppKey"
            android:value="${kakaoNativeAppKey}" />
        <activity
            android:name="com.kakao.sdk.flutter.auth.AuthCodeHandlerActivity"
            android:exported="true">
            <intent-filter android:label="kakao_oauth">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="kakao${kakaoNativeAppKey}" android:host="oauth" />
            </intent-filter>
        </activity>

        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- Chrome Custom Tab 지원 선언 (Android 11+ 패키지 가시성 제한).
             Firebase Auth signInWithProvider OAuth 플로우에서 Custom Tab을
             사용하려면 CustomTabsService를 쿼리할 수 있어야 한다.
             Firebase Auth SDK와 androidx.browser 모두 이 선언을 포함하지
             않으므로 앱에서 직접 선언해야 한다.
             refs: firebase-android-sdk#3620 -->
        <intent>
            <action android:name="android.support.customtabs.action.CustomTabsService" />
        </intent>
        <!-- Facebook 앱 감지 (Android 11+ 패키지 가시성 제한, Phase 9). -->
        <provider android:authorities="com.facebook.katana.provider.PlatformProvider" />
        <!-- KakaoTalk 패키지 가시성 (Phase 12, Android 11+). 설치 감지 후
             loginWithKakaoTalk vs loginWithKakaoAccount 분기 (D-01).
             kakao_flutter_sdk_common 의 AndroidManifest.xml에도 동일 선언이
             있어 manifest merge 시 자동 포함되지만, 명시성을 위해 앱 측에도 등록한다. -->
        <package android:name="com.kakao.talk" />
        <!-- LINE 패키지 가시성 (Phase 14 D-LINE-18 — see ROADMAP.md, Android 11+).
             LINE 앱 설치 감지 후 app-to-app OAuth 분기. flutter_line_sdk
             native plugin 의 manifest merge 가 본 entry 를 추가할 수도 있으나
             명시성 + Wave 3 A3 emulator 검증 의무 (manual.md "## LINE Login").
             패키지 미선언 시 Android 11+ 에서 LINE 앱 존재 확인 불가 → 무조건
             web fallback 으로 강제됨. -->
        <package android:name="jp.naver.line.android" />
    </queries>
</manifest>
