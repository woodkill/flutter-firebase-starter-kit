<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application
        android:label="flutter_starter_kit"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <!-- 최근 앱 자동 제거 (debug notification-task-duplication RC2 · 2026-10-03).
             알림 탭으로 만든 task 의 루트 Activity 는 홈(런처) 발 실행이 아니라서
             시스템 뒤로에서 finish 된다(Android 12+ 의 「루트 런처 Activity 는 뒤로 대신
             task 를 뒤로 보냄」 규칙은 홈 발 실행에만 적용). 빈 taskAffinity 라 런처 실행이
             그 빈 task 를 최근 앱에서 지우지 못하면 카드가 2장이 되고, 옛 카드가 옛 알림
             intent 를 재실행하며, 두 task 가 함께 살면 Flutter 엔진 2개로 포그라운드 알림이
             2건씩 뜬다. 그래서 MainActivity 를 루트로 한 task 는 마지막 Activity 가 끝나면
             최근 앱에서 바로 빠지게 한다. 빈 taskAffinity 는 StrandHogg 방어라 유지한다.
             대가: 런처로 연 앱이라도 Android 7~11 에서는 루트 뒤로가 finish 라 카드가
             사라진다(AOSP 소스 근거 · 단말 미실측). Android 12+ 는 런처로 연 루트를 뒤로에서
             task 째 뒤로 보내므로 카드가 남는다. 대조 테스트는
             phase17_platform_config_test 의 PLATFORM-06 이다.

             이 주석에 XML 속성 리터럴을 쓰지 않는 이유는 아래 Naver 블록과 같다. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:autoRemoveFromRecents="true"
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Facebook SDK 설정 (D-06, Phase 9).
             App ID와 Client Token은 build.gradle.kts resValue로 주입된다. -->
        <meta-data
            android:name="com.facebook.sdk.ApplicationId"
            android:value="@string/facebook_app_id"/>
        <meta-data
            android:name="com.facebook.sdk.ClientToken"
            android:value="@string/facebook_client_token"/>

        <!-- Kakao SDK 설정 (Phase 12 D-21).
             Native App Key는 build.gradle.kts manifestPlaceholders로 주입된다.
             Auth Activity (com.kakao.sdk.flutter.auth.AuthCodeHandlerActivity) 자체는
             kakao_flutter_sdk_auth 패키지의 AndroidManifest.xml에서 자동 merge되며,
             URL scheme (kakao${kakaoNativeAppKey}://oauth) intent-filter만 앱 측에서
             등록한다 (앱별 nativeAppKey가 다르므로). -->
        <meta-data
            android:name="com.kakao.sdk.AppKey"
            android:value="${kakaoNativeAppKey}" />
        <activity
            android:name="com.kakao.sdk.flutter.auth.AuthCodeHandlerActivity"
            android:exported="true">
            <intent-filter android:label="kakao_oauth">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="kakao${kakaoNativeAppKey}" android:host="oauth" />
            </intent-filter>
        </activity>

        <!-- Naver Login SDK 설정 (Phase 16.2 D-01 · D-07).
             값은 build.gradle.kts 의 resValue 로 주입되고, 네이티브 디버그
             로깅은 전 flavor 상시 off 다. Activity 와 패키지 가시성 선언은
             SDK AAR 이 스스로 병합하므로 앱 측에서 중복하지 않는다.

             이 주석에 XML 속성 리터럴을 쓰지 않는 이유: manifest merger 가
             주석을 병합 산출물로 그대로 복사하므로, 감사용 grep 카운트가
             오염된다. -->
        <meta-data
            android:name="com.naver.sdk.clientId"
            android:value="@string/naver_client_id" />
        <meta-data
            android:name="com.naver.sdk.clientSecret"
            android:value="@string/naver_client_secret" />
        <meta-data
            android:name="com.naver.sdk.clientName"
            android:value="@string/naver_client_name" />
        <meta-data
            android:name="com.naver.sdk.logEnabled"
            android:value="false" />

        <!-- Phase 17 — see ROADMAP.md · FCM 백그라운드 · 종료 상태 알림 기본값 (D-01) ·
             채널 id 는 plan 16 의 로컬 알림 채널과 같다. 앱이 백그라운드 · 종료
             상태일 때는 Flutter 가 아니라 OS 가 알림을 그리므로 아이콘 · 색 · 채널을
             여기서 정한다. 알림 권한 선언은 플러그인 manifest 가 병합한다. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_notification" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/notification_color" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="general" />

        <!-- Phase 16.5 D-07 · D-09 · G-16.5-2 — 킷 소유 웹 OAuth 콜백 relay
             (NAVER 앱 미설치 경로 · Auth Tab 미지원 브라우저의 Custom Tab fallback).
             flutter_web_auth_2 README 는 라이브러리 콜백 Activity 선언을 요구하지만,
             킷은 그 대신 킷 소유 relay Activity 를 콜백 수신자로 둔다. 라이브러리
             콜백 Activity 의 Custom Tab 닫기는 같은 task 전용이라 빈 affinity 조합에서
             tab 이 남기 때문이다 (upstream issue 158). relay 는 결과를 플러그인에
             넘긴 뒤 MainActivity 의 기존 task 를 앞으로 되돌려 tab 을 걷는다.
             Chrome Auth Tab 경로는 결과가 ActivityResult 로 돌아와 relay 를 기동하지
             않는다. MainActivity 와 relay 의 빈 affinity 는 StrandHogg(task hijacking)
             방어라 유지한다. 라이브러리 인증 관리 Activity 는 여기서 재선언하지
             않는다 (Chrome Auth Tab 경로의 task 배치가 바뀐다).

             콜백 scheme 은 build.gradle.kts 의 manifest placeholder 가 flavor 별
             config json 에서 공급한다 (Dart 쪽 콜백 scheme 상수와 같은 값). 웹 인증
             세션 Activity 자체는 패키지 manifest 가 스스로 병합한다. NAVER 앱
             패키지 가시성은 위 Naver 블록 설명대로 SDK AAR 이 병합하므로 queries
             에 중복하지 않는다.

             이 주석에 XML 속성 리터럴을 쓰지 않는 이유는 위 Naver 블록과 같다. -->
        <activity
            android:name=".WebAuthCallbackActivity"
            android:exported="true"
            android:taskAffinity="">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="${naverWebCallbackScheme}" />
            </intent-filter>
        </activity>

        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- Chrome Custom Tab 지원 선언 (Android 11+ 패키지 가시성 제한).
             Firebase Auth signInWithProvider OAuth 플로우에서 Custom Tab을
             사용하려면 CustomTabsService를 쿼리할 수 있어야 한다.
             Firebase Auth SDK와 androidx.browser 모두 이 선언을 포함하지
             않으므로 앱에서 직접 선언해야 한다.
             refs: firebase-android-sdk#3620 -->
        <intent>
            <action android:name="android.support.customtabs.action.CustomTabsService" />
        </intent>
        <!-- Facebook 앱 패키지 가시성 (Android 11+, Phase 9 / quick 260913-tgj).
             출처 = Facebook Android troubleshooting FAQ 의 공식 스니펫 —
             https://developers.facebook.com/docs/android/troubleshooting/
             Facebook 본체와 Messenger 두 앱의 PlatformProvider authority 2건이
             전부다. SDK 가 자기 라이브러리 manifest 에서 스스로 병합하는 선언은
             여기서 중복하지 않는다.

             주의 — 이 선언으로 네이티브 로그인이 살아나지는 않는다. 2026-09-13
             실측(Galaxy SM-S942N, Facebook 앱 v576.0.0.42.73)에서 Facebook 앱이
             자기 ProxyAuth 액티비티를 비활성 상태로 배포해, SDK 의 resolveActivity
             가 null 을 받고 Custom Tab 으로 폴백한다. 앱 측 결정이라 우리 manifest
             로는 바꿀 수 없다. 다만 단말 1대 · 앱 1버전 실측이고, Meta 의 폐지 공지를
             확인한 바 없으며, 비활성 플래그는 런타임에 되살아날 수 있다. 공식 문서가
             요구하는 선언이고 비용이 0 이므로 유지한다 — 네이티브 로그인 복구가
             목적이 아니다.
             근거 원본: .planning/phases/09-facebook-login/uat-evidence/
                        2026-09-13-facebook-native-handoff.md

             이 주석에 XML 속성 리터럴을 쓰지 않는 이유: manifest merger 가 주석을
             병합 산출물로 그대로 복사하므로, 감사용 grep 카운트가 오염된다. -->
        <provider android:authorities="com.facebook.katana.provider.PlatformProvider" />
        <provider android:authorities="com.facebook.orca.provider.PlatformProvider" />
        <!-- KakaoTalk 패키지 가시성 (Phase 12, Android 11+). 설치 감지 후
             loginWithKakaoTalk vs loginWithKakaoAccount 분기 (D-01).
             kakao_flutter_sdk_common 의 AndroidManifest.xml에도 동일 선언이
             있어 manifest merge 시 자동 포함되지만, 명시성을 위해 앱 측에도 등록한다. -->
        <package android:name="com.kakao.talk" />
        <!-- LINE 패키지 가시성 (Phase 14 D-LINE-18 — see ROADMAP.md, Android 11+).
             LINE 앱 설치 감지 후 app-to-app OAuth 분기. flutter_line_sdk
             native plugin 의 manifest merge 가 본 entry 를 추가할 수도 있으나
             명시성 + Wave 3 A3 emulator 검증 의무 (manual.md "## LINE Login").
             패키지 미선언 시 Android 11+ 에서 LINE 앱 존재 확인 불가 → 무조건
             web fallback 으로 강제됨. -->
        <package android:name="jp.naver.line.android" />
    </queries>
</manifest>
