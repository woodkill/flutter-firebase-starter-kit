<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application
        android:label="flutter_starter_kit"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Facebook SDK 설정 (D-06, Phase 9).
             App ID와 Client Token은 build.gradle.kts resValue로 주입된다. -->
        <meta-data
            android:name="com.facebook.sdk.ApplicationId"
            android:value="@string/facebook_app_id"/>
        <meta-data
            android:name="com.facebook.sdk.ClientToken"
            android:value="@string/facebook_client_token"/>

        <!-- Kakao SDK 설정 (Phase 12 D-21).
             Native App Key는 build.gradle.kts manifestPlaceholders로 주입된다.
             Auth Activity (com.kakao.sdk.flutter.auth.AuthCodeHandlerActivity) 자체는
             kakao_flutter_sdk_auth 패키지의 AndroidManifest.xml에서 자동 merge되며,
             URL scheme (kakao${kakaoNativeAppKey}://oauth) intent-filter만 앱 측에서
             등록한다 (앱별 nativeAppKey가 다르므로). -->
        <meta-data
            android:name="com.kakao.sdk.AppKey"
            android:value="${kakaoNativeAppKey}" />
        <activity
            android:name="com.kakao.sdk.flutter.auth.AuthCodeHandlerActivity"
            android:exported="true">
            <intent-filter android:label="kakao_oauth">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="kakao${kakaoNativeAppKey}" android:host="oauth" />
            </intent-filter>
        </activity>

        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- Chrome Custom Tab 지원 선언 (Android 11+ 패키지 가시성 제한).
             Firebase Auth signInWithProvider OAuth 플로우에서 Custom Tab을
             사용하려면 CustomTabsService를 쿼리할 수 있어야 한다.
             Firebase Auth SDK와 androidx.browser 모두 이 선언을 포함하지
             않으므로 앱에서 직접 선언해야 한다.
             refs: firebase-android-sdk#3620 -->
        <intent>
            <action android:name="android.support.customtabs.action.CustomTabsService" />
        </intent>
        <!-- Facebook 앱 감지 (Android 11+ 패키지 가시성 제한, Phase 9 / quick
             260913-r8a — 09-UAT.md Gap 4).

             왜 3건이 아니라 2건만 추가하는가 (facebook-login:18.1.3 AAR 실측):
             1) katana 는 facebook-common:18.1.3 라이브러리 manifest 가
                queries > package (name = com.facebook.katana) 를 자체 선언하므로
                manifest merge 로 자동 포함된다 (실측: merged manifest 의 해당
                선언이 facebook-common-18.1.3/AndroidManifest.xml:16 에 blame 됨).
                앱에서 중복 선언하지 않는다 — 아래 provider 권한 선언은 Phase 9
                부터 있던 것으로 그대로 보존한다.
                주석에 XML 속성 리터럴 형태를 쓰지 않는 이유: merged manifest 는
                주석까지 그대로 옮기므로, 감사용 grep 카운트가 오염된다.
             2) NativeProtocol.buildFacebookAppList() 는 KatanaAppInfo 와
                WakizashiAppInfo 를 모두 후보에 넣고 각각의 PlatformProvider 를
                조회한다. 추가로 AttributionIdentifiers 와
                appevents.ondeviceprocessing.RemoteServiceWrapper 도 Wakizashi
                빌드의 provider · service 에 접근한다. 어디에서도 선언되지
                않으므로 여기가 실제 가시성 구멍이다 → 아래 2줄로 메운다.
             3) Facebook Lite 는 SDK 18.1.3 의 core/common/login 세 AAR 클래스
                상수 풀에 참조가 0건이라 선언해도 사용하는 코드 경로가 없다.
                의도적으로 제외한다. -->
        <provider android:authorities="com.facebook.katana.provider.PlatformProvider" />
        <provider android:authorities="com.facebook.wakizashi.provider.PlatformProvider" />
        <package android:name="com.facebook.wakizashi" />
        <!-- KakaoTalk 패키지 가시성 (Phase 12, Android 11+). 설치 감지 후
             loginWithKakaoTalk vs loginWithKakaoAccount 분기 (D-01).
             kakao_flutter_sdk_common 의 AndroidManifest.xml에도 동일 선언이
             있어 manifest merge 시 자동 포함되지만, 명시성을 위해 앱 측에도 등록한다. -->
        <package android:name="com.kakao.talk" />
        <!-- LINE 패키지 가시성 (Phase 14 D-LINE-18 — see ROADMAP.md, Android 11+).
             LINE 앱 설치 감지 후 app-to-app OAuth 분기. flutter_line_sdk
             native plugin 의 manifest merge 가 본 entry 를 추가할 수도 있으나
             명시성 + Wave 3 A3 emulator 검증 의무 (manual.md "## LINE Login").
             패키지 미선언 시 Android 11+ 에서 LINE 앱 존재 확인 불가 → 무조건
             web fallback 으로 강제됨. -->
        <package android:name="jp.naver.line.android" />
    </queries>
</manifest>
