# Trigger Email 확장(firestore-send-email) 파라미터 — 모든 프로젝트 공통 값(킷 소유).
# 프로젝트별 값은 firestore-send-email.env.<projectId> (git 밖) 에 둔다 — 예시는 firestore-send-email.env.example.
# 메일 본문은 함수 코드가 렌더하므로 확장의 templates · users 컬렉션 파라미터는 쓰지 않는다.
DATABASE=(default)
AUTH_TYPE=UsernamePassword
MAIL_COLLECTION=mail
TTL_EXPIRE_TYPE=day
TTL_EXPIRE_VALUE=1
