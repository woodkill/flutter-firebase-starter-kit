rules_version = '2';

// ============================================================================
// Firestore Security Rules — 필드 단위 소유권 모델.
// ----------------------------------------------------------------------------
// Phase 17 — see ROADMAP.md: 필드 단위 소유권 모델(D-13 · D-38 · D-39).
// - 서버 전용 키(linkedProviders · providerLinkedAt · email · emailVerified ·
//   IdP 프로필 미러)는 Admin SDK(Cloud Functions)만 쓴다. Admin SDK 는 본
//   ruleset 을 우회한다.
// - 클라이언트 write 화이트리스트 = termsAccepted · signUpProviderId ·
//   customPhotoUrl 3키.
// - 약관(termsAccepted)은 규칙으로 삭제 · version 역행 · 미래 시각을 막는다.
// - 가입 수단(signUpProviderId)은 write-once 다.
//
// WR-12(Phase 15 리뷰) 알려진 갭 — 「본인 문서 전체 write 허용」 — 은 이 규칙으로
// 닫혔다. 클라이언트 write 경로를 서버 callable 로 옮기는 안은 채택하지 않았다
// (D-39 — 약관 내용은 어느 쪽이든 기기에서 오고, Phase 10 약관 흐름의 회귀 위험).
//
// 한계: write-once 는 서버 검증이 아니다 — native 가입 수단의 최초 값은 여전히
// 클라이언트 자기 주장이며 영향은 자기 계정뿐이다(D-38). acceptedAt 은 기기
// 시각이라 기기 시계가 서버보다 앞서면 약관 mirror 가 거부되고, 다음 전이 ·
// 재동의 때 다시 시도된다(허용 오차 0 — 사용자 결정 2026-10-01).
//
// 검증: functions/test/rules/firestore.rules.test.ts (`pnpm test:rules`, 에뮬레이터).
// ============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ------------------------------------------------------------------------
    // 공통 helper.
    // ------------------------------------------------------------------------

    // 인증된 본인인지 판정한다.
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // 익명이 아닌 정식 사용자인지 판정한다 (D-28 — 익명 계정은 30일 뒤 Auth 만
    // 지워져 Firestore 데이터가 고아가 된다).
    function isRegular() {
      return request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    // D-13 클라이언트 write 화이트리스트 — 그 외 키는 Admin SDK 전용.
    function clientKeys() {
      return ['termsAccepted', 'signUpProviderId', 'customPhotoUrl'];
    }

    // D-39 ③④⑤ — 약관 5필드 정확 · 타입 · 필수 동의 true · 미래 시각 금지.
    // `service` 는 rules 예약어라 `t.service` 대신 `t['service']` 로 읽는다.
    function termsShape(t) {
      return t is map
        && t.keys().hasOnly(['version', 'service', 'privacy', 'marketing', 'acceptedAt'])
        && t.keys().hasAll(['version', 'service', 'privacy', 'marketing', 'acceptedAt'])
        && t.version is int
        && t['service'] == true
        && t.privacy == true
        && t.marketing is bool
        && t.acceptedAt is timestamp
        && t.acceptedAt <= request.time;
    }

    // D-39 ② — 약관이 있으면 형식을 지키고 version 은 비감소(재동의 = 같거나 큰 버전).
    function termsOk(data, prev) {
      return !('termsAccepted' in data)
        || (termsShape(data.termsAccepted)
          && (prev == null
            || !('termsAccepted' in prev)
            || data.termsAccepted.version >= prev.termsAccepted.version));
    }

    // D-39 ① — 한 번 기록된 약관은 삭제할 수 없다.
    function termsNotDeleted(data, prev) {
      return prev == null || !('termsAccepted' in prev) || ('termsAccepted' in data);
    }

    // D-38 — 가입 수단은 없을 때만 쓰고, 있으면 같은 값 재기록만 허용한다
    // (변경 · 삭제 · 빈 문자열 거부).
    function signUpWriteOnce(data, prev) {
      return !('signUpProviderId' in data)
        ? (prev == null || !('signUpProviderId' in prev))
        : (data.signUpProviderId is string
          && data.signUpProviderId.size() > 0
          && (prev == null
            || !('signUpProviderId' in prev)
            || data.signUpProviderId == prev.signUpProviderId));
    }

    // update 에서 [key] 가 바뀌는지(추가 · 변경 · 삭제) 판정한다 (리뷰 IN-01).
    // 바뀌지 않은 키는 다시 검증하지 않는다 — 사진 업로드 같은 무관한 write 가
    // 기존 약관 · 가입 수단 값의 모양(legacy 미래 acceptedAt 등)에 묶이지 않게.
    function changes(key) {
      return key in request.resource.data.diff(resource.data).affectedKeys();
    }

    // D-17 — 앱 소유 프로필 사진 URL 은 문자열 또는 null.
    function photoOk(data) {
      return !('customPhotoUrl' in data)
        || data.customPhotoUrl == null
        || data.customPhotoUrl is string;
    }

    // ------------------------------------------------------------------------
    // identity_index 컬렉션 — 클라이언트 read/write 전면 차단.
    // ------------------------------------------------------------------------
    // Phase 12 D-09 Identity Index 컬렉션 = `{provider}:{providerUserId}` 키.
    // Cloud Function `kakaoCustomToken` (12-02) 가 Admin SDK 로 접근하며,
    // Admin SDK 호출은 본 ruleset 을 우회한다. 클라이언트는 다른 사용자의
    // 매핑 노출 (T-12-06-01) 위험이 있으므로 read/write 전면 차단.
    match /identity_index/{document=**} {
      allow read, write: if false;
    }

    // ------------------------------------------------------------------------
    // users 컬렉션 — 본인 + 필드 화이트리스트.
    // ------------------------------------------------------------------------
    // 본인 (request.auth.uid == userId) 만 read 하고, write 는 화이트리스트
    // 키만 허용한다 — 다른 사용자 문서 변조 (T-12-06-02) · 서버 전용 키 조작
    // (WR-12) 차단. set-merge 는 문서가 없으면 create, 있으면 update 로 평가된다.
    //
    // 클라이언트 진입점:
    // - Plan 10-09 termsProvider: users/{uid} stream watch
    // - Plan 10-12 mirrorToFirestore: termsAccepted set-merge (force 재동의 포함)
    // - Plan 12-06 currentUserProvider: linkedProviders stream watch
    // - Phase 16.7 SignUpMethodRecorder: signUpProviderId set-merge (write-once)
    // - Phase 17 프로필 사진: customPhotoUrl set-merge
    // - Phase 17 FCM 토큰: users/{uid}/fcmTokens/{token} 문서 write · delete
    //
    // Cloud Function (Admin SDK) 진입점:
    // - 12-02 kakaoCustomToken 등: linkedProviders + providerLinkedAt +
    //   signUpProviderId set-merge
    // - mirrorTermsAcceptance: termsAccepted set-merge
    // - deleteUserAccount: 문서 · 서브컬렉션 삭제 (탈퇴)
    match /users/{userId} {
      allow read: if isOwner(userId);

      allow create: if isOwner(userId)
        && request.resource.data.keys().hasOnly(clientKeys())
        && termsOk(request.resource.data, null)
        && signUpWriteOnce(request.resource.data, null)
        && photoOk(request.resource.data);

      // 각 검증은 해당 키가 바뀔 때만 평가한다 (리뷰 IN-01). 삭제도
      // affectedKeys 에 들어가므로 약관 삭제 · 가입 수단 삭제는 그대로 거부된다.
      allow update: if isOwner(userId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(clientKeys())
        && (!changes('termsAccepted')
          || (termsOk(request.resource.data, resource.data)
            && termsNotDeleted(request.resource.data, resource.data)))
        && (!changes('signUpProviderId')
          || signUpWriteOnce(request.resource.data, resource.data))
        && (!changes('customPhotoUrl') || photoOk(request.resource.data));

      // 탈퇴는 Admin(deleteUserAccount) 만 문서를 지운다.
      allow delete: if false;

      // ----------------------------------------------------------------------
      // fcmTokens 서브컬렉션 — 정식 사용자 본인 기기 토큰 (D-02 · D-28).
      // ----------------------------------------------------------------------
      // 문서 id = FCM 토큰. 키는 5개 이하(hasOnly)이고 아래 조건이 5키를 모두
      // 참조하므로 누락 키는 평가 오류 → 거부된다. platform/locale 은 지원 집합만.
      match /fcmTokens/{token} {
        allow read, delete: if isOwner(userId);

        allow create, update: if isOwner(userId)
          && isRegular()
          && request.resource.data.keys().hasOnly(['token', 'platform', 'locale', 'updatedAt', 'expireAt'])
          && request.resource.data.token == token
          && request.resource.data.platform in ['android', 'ios']
          && request.resource.data.locale in ['ko', 'en', 'ja']
          && request.resource.data.updatedAt is timestamp
          && request.resource.data.expireAt is timestamp;
      }
    }
  }
}
