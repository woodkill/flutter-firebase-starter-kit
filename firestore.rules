rules_version = '2';

// ============================================================================
// Phase 12 Plan 06 — 임시 Firestore Security Rules (D-14).
// ----------------------------------------------------------------------------
// Phase 18 — see ROADMAP.md (정식 ruleset 도입 전까지의 최소 보호 ruleset).
//
// 보호 정책:
// - identity_index: 클라이언트 read/write 전면 차단. Cloud Function (Admin
//   SDK) 만 접근. Phase 12 D-14 / 12-02 Identity Index lookup-first.
// - users/{uid}: 자기 자신만 read/write 임시 허용 (Phase 18 — see ROADMAP.md, 일반화 대기).
//   Plan 10-09 termsProvider stream + Plan 10-12 mirrorToFirestore +
//   12-02 Cloud Function set-merge 가 동일 ruleset 안에서 동작.
//
// **TODO: Phase 18 일반화 (see ROADMAP.md):** users/{uid} 정식 ruleset 일반화 시 본 임시 규칙
// cleanup. 회원탈퇴용 self-delete + 필드 단위 보호 (linkedProviders 는
// Cloud Function 만 write 등) 도입 검토.
// ============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ------------------------------------------------------------------------
    // identity_index 컬렉션 — D-14 클라이언트 차단.
    // ------------------------------------------------------------------------
    // Phase 12 D-09 Identity Index 컬렉션 = `{provider}:{providerUserId}` 키.
    // Cloud Function `kakaoCustomToken` (12-02) 가 Admin SDK 로 접근하며,
    // Admin SDK 호출은 본 ruleset 을 우회한다. 클라이언트는 다른 사용자의
    // 매핑 노출 (T-12-06-01) 위험이 있으므로 read/write 전면 차단.
    match /identity_index/{document=**} {
      allow read, write: if false;
    }

    // ------------------------------------------------------------------------
    // users 컬렉션 — Phase 12 임시 ruleset (Phase 18 — see ROADMAP.md, 일반화 대기).
    // ------------------------------------------------------------------------
    // 자기 자신 (request.auth.uid == userId) 만 read / write 허용 — 다른
    // 사용자의 linkedProviders 변조 (T-12-06-02) 차단.
    //
    // 클라이언트 진입점:
    // - Plan 10-09 termsProvider: users/{uid} stream watch
    // - Plan 10-12 mirrorToFirestore: termsAccepted set-merge
    // - Plan 12-06 currentUserProvider: linkedProviders stream watch
    //
    // Cloud Function (Admin SDK) 진입점:
    // - 12-02 kakaoCustomToken: linkedProviders + providerLinkedAt set-merge
    //
    // **WR-12 (Phase 15 리뷰) — 알려진 갭, Phase 18 작업 항목:**
    // 본 규칙은 본인 문서 전체 write 를 허용하므로 client 가 callable 을
    // 거치지 않고 `termsAccepted` / `linkedProviders` / `providerLinkedAt` 을
    // 직접 조작할 수 있다. 서버의 `SERVER_TERMS_CURRENT_VERSION` 상한은 서버
    // 경유 경로의 형식 정규화일 뿐 위조 방어가 아니다 (그 상수 docstring 에
    // 명시). 지금 필드 단위 write 금지를 도입하면 client 의
    // `TermsNotifier.mirrorToFirestore` (termsAccepted 직접 set) 가 깨지므로,
    // 규칙 강화는 **client write 경로를 서버 callable 로 이전하는 작업과 함께**
    // 수행해야 한다.
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
