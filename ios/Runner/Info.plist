<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
	<dict>
		<key>CADisableMinimumFrameDurationOnPhone</key>
		<true/>
		<key>CFBundleDevelopmentRegion</key>
		<string>$(DEVELOPMENT_LANGUAGE)</string>
		<key>CFBundleDisplayName</key>
		<string>Flutter Starter Kit</string>
		<key>CFBundleExecutable</key>
		<string>$(EXECUTABLE_NAME)</string>
		<key>CFBundleIdentifier</key>
		<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
		<key>CFBundleInfoDictionaryVersion</key>
		<string>6.0</string>
		<key>CFBundleName</key>
		<string>flutter_starter_kit</string>
		<key>CFBundlePackageType</key>
		<string>APPL</string>
		<key>CFBundleShortVersionString</key>
		<string>$(FLUTTER_BUILD_NAME)</string>
		<key>CFBundleSignature</key>
		<string>????</string>
		<!-- xcconfig 키가 비면 :default= 로 앱 고유 자리표시 scheme 이 들어간다 (Phase 17.3 — see ROADMAP.md).
		     끈 provider 가 다른 앱과 같은 scheme(fb · kakao · 빈 값)을 등록하지 않게 한다.
		     값이 있으면 그 값이 그대로 들어간다. provider on/off CSV 는 읽지 않는다. -->
		<key>CFBundleURLTypes</key>
		<array>
			<dict>
				<key>CFBundleTypeRole</key>
				<string>Editor</string>
				<key>CFBundleURLSchemes</key>
				<array>
					<string>$(REVERSED_CLIENT_ID:default=unset.google.$(PRODUCT_BUNDLE_IDENTIFIER))</string>
				</array>
			</dict>
			<dict>
				<key>CFBundleURLSchemes</key>
				<array>
					<string>fb$(FACEBOOK_APP_ID:default=unset.$(PRODUCT_BUNDLE_IDENTIFIER))</string>
				</array>
			</dict>
			<dict>
				<key>CFBundleTypeRole</key>
				<string>Editor</string>
				<key>CFBundleURLName</key>
				<string>kakao</string>
				<key>CFBundleURLSchemes</key>
				<array>
					<string>kakao$(KAKAO_NATIVE_APP_KEY:default=unset.$(PRODUCT_BUNDLE_IDENTIFIER))</string>
				</array>
			</dict>
			<!-- Naver Login (Phase 13 — see ROADMAP.md). xcconfig NAVER_URL_SCHEME 변수 substitution. -->
			<dict>
				<key>CFBundleTypeRole</key>
				<string>Editor</string>
				<key>CFBundleURLName</key>
				<string>naver</string>
				<key>CFBundleURLSchemes</key>
				<array>
					<string>$(NAVER_URL_SCHEME:default=unset.naver.$(PRODUCT_BUNDLE_IDENTIFIER))</string>
				</array>
			</dict>
			<!-- LINE Login (Phase 14 — see ROADMAP.md, D-LINE-18).
			     flutter_line_sdk README verbatim: line3rdp.$(PRODUCT_BUNDLE_IDENTIFIER)
			     scheme 으로 LINE 앱이 OAuth 결과를 본 앱으로 콜백한다. -->
			<dict>
				<key>CFBundleTypeRole</key>
				<string>Editor</string>
				<key>CFBundleURLName</key>
				<string>line</string>
				<key>CFBundleURLSchemes</key>
				<array>
					<string>line3rdp.$(PRODUCT_BUNDLE_IDENTIFIER)</string>
				</array>
			</dict>
		</array>
		<key>FacebookAppID</key>
		<string>$(FACEBOOK_APP_ID)</string>
		<key>FacebookClientToken</key>
		<string>$(FACEBOOK_CLIENT_TOKEN)</string>
		<key>FacebookDisplayName</key>
		<string>$(DISPLAY_NAME)</string>
		<!-- Naver Login native 설정 (Phase 16.2 D-02 · D-06 — see ROADMAP.md).
		     xcconfig 변수 substitution. NidUrlScheme 은 위 CFBundleURLSchemes 의
		     naver 항목과 같은 값이어야 한다 — 플러그인이 이 값으로 복귀 URL 을
		     필터링한다. 동의 화면 앱 이름은 기존 DISPLAY_NAME 을 재사용한다(신규 변수 0). -->
		<key>NidClientID</key>
		<string>$(NAVER_CLIENT_ID)</string>
		<key>NidClientSecret</key>
		<string>$(NAVER_CLIENT_SECRET)</string>
		<key>NidAppName</key>
		<string>$(DISPLAY_NAME)</string>
		<key>NidUrlScheme</key>
		<string>$(NAVER_URL_SCHEME:default=unset.naver.$(PRODUCT_BUNDLE_IDENTIFIER))</string>
		<!-- 갤러리 사진 선택 권한 문구 (Phase 17 D-15 — see ROADMAP.md).
		     image_picker README 필수 키. 이 plist 에는 lproj 현지화가 없으므로
		     영문 1문장이며, 현지화는 InfoPlist.strings 로 추가한다(매뉴얼 커스터마이징 포인트). -->
		<key>NSPhotoLibraryUsageDescription</key>
		<string>Choose a photo from your library to use as your profile photo.</string>
		<key>CFBundleVersion</key>
		<string>$(FLUTTER_BUILD_NUMBER)</string>
		<key>LSRequiresIPhoneOS</key>
		<true/>
		<key>UIApplicationSceneManifest</key>
		<dict>
			<key>UIApplicationSupportsMultipleScenes</key>
			<false/>
			<key>UISceneConfigurations</key>
			<dict>
				<key>UIWindowSceneSessionRoleApplication</key>
				<array>
					<dict>
						<key>UISceneClassName</key>
						<string>UIWindowScene</string>
						<key>UISceneConfigurationName</key>
						<string>flutter</string>
						<key>UISceneDelegateClassName</key>
						<string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>
						<key>UISceneStoryboardFile</key>
						<string>Main</string>
					</dict>
				</array>
			</dict>
		</dict>
		<key>UIApplicationSupportsIndirectInputEvents</key>
		<true/>
		<!-- FCM 백그라운드 수신 (Phase 17 D-07 — see ROADMAP.md). Xcode Background Modes
		     capability 의 Background fetch · Remote notifications 와 같은 값.
		     실기기 APNs 검증은 Phase 18 iOS batch. -->
		<key>UIBackgroundModes</key>
		<array>
			<string>fetch</string>
			<string>remote-notification</string>
		</array>
		<key>UILaunchStoryboardName</key>
		<string>LaunchScreen</string>
		<key>UIMainStoryboardFile</key>
		<string>Main</string>
		<key>UISupportedInterfaceOrientations</key>
		<array>
			<string>UIInterfaceOrientationPortrait</string>
			<string>UIInterfaceOrientationLandscapeLeft</string>
			<string>UIInterfaceOrientationLandscapeRight</string>
		</array>
		<key>UISupportedInterfaceOrientations~ipad</key>
		<array>
			<string>UIInterfaceOrientationPortrait</string>
			<string>UIInterfaceOrientationPortraitUpsideDown</string>
			<string>UIInterfaceOrientationLandscapeLeft</string>
			<string>UIInterfaceOrientationLandscapeRight</string>
		</array>
		<key>LSApplicationQueriesSchemes</key>
		<array>
			<string>fbapi</string>
			<string>fb-messenger-share-api</string>
			<!-- Kakao Login (Phase 12 D-21). KakaoTalk 설치 감지 + OAuth 호출. -->
			<string>kakaokompassauth</string>
			<string>kakaolink</string>
			<string>kakaotalk</string>
			<!-- Naver Login (Phase 13 — see ROADMAP.md). 네이버앱 / 네이버서치앱 감지 + 1-tap deeplink. -->
			<string>naversearchapp</string>
			<string>naversearchthirdlogin</string>
			<!-- LINE Login (Phase 14 — see ROADMAP.md, D-LINE-18).
			     flutter_line_sdk README verbatim. LINE 앱 설치 감지 +
			     app-to-app OAuth (auth url scheme lineauth2://). -->
			<string>lineauth2</string>
		</array>
		<key>UIStatusBarHidden</key>
		<false/>
	</dict>
</plist>
