# iOS 최소 배포 타겟 — 단일 출처(single source of truth)
# - Firebase SDK 요구사항에 따라 15.6 을 하한으로 둔다.
# - ios/Runner.xcodeproj/project.pbxproj 의 IPHONEOS_DEPLOYMENT_TARGET 12개 값과 반드시 같아야 한다.
# - 일치 여부는 test/ios/ios_deployment_target_consistency_test.dart 가 강제한다.
ios_deployment_target = '15.6'
platform :ios, ios_deployment_target

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Debug-dev' => :debug,
  'Debug-stg' => :debug,
  'Debug-prod' => :debug,
  'Profile' => :release,
  'Profile-dev' => :release,
  'Profile-stg' => :release,
  'Profile-prod' => :release,
  'Release' => :release,
  'Release-dev' => :release,
  'Release-stg' => :release,
  'Release-prod' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  use_frameworks!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
  target 'RunnerTests' do
    inherit! :search_paths
  end
end

# pod target 의 deployment target 하한 상향 규칙
# - pod target 의 하한(예: podspec 15.0)이 의존 모듈 하한(LineSDKSwift 5.17.0 = 15.0)이나
#   Runner 하한보다 낮으면 Swift module import 시 "Compiling for iOS X, but module 'Y' has a
#   minimum deployment target" 컴파일 에러가 난다.
# - flutter_additional_ios_build_settings 는 **15 미만**일 때만 키를 지워 Runner 값을
#   상속시킨다(Flutter 3.47.5 podhelper.rb:49 `inherit_deployment_target = … < 15`,
#   삭제는 85-91행). Flutter 3.41 까지는 이 기준이 13 이었다.
# - 즉 15 미만 target 은 helper 가 알아서 Runner 값(ios_deployment_target)을 상속하고,
#   15 이상이면서 ios_deployment_target 미만인 값(예: 15.0 < 15.6)만 키가 남는다.
#   아래 루프는 그렇게 남은 값만 올린다.
# - 하향은 하지 않는다(pod 이 스스로 요구하는 더 높은 하한을 가리지 않기 위해).
#   키가 없거나 비숫자 값($(inherited) 등)이면 건드리지 않는다.
post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)

    target.build_configurations.each do |build_configuration|
      current_target = build_configuration.build_settings['IPHONEOS_DEPLOYMENT_TARGET']
      next unless current_target.is_a?(String) && current_target.match?(/\A\d+(\.\d+)*\z/)
      next unless Gem::Version.new(current_target) < Gem::Version.new(ios_deployment_target)

      build_configuration.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = ios_deployment_target
    end
  end
end
