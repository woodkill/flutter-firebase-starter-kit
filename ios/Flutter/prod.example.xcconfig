// prod flavor 의 iOS 빌드 변수 예시 — 값은 모두 자리표시다.
// ./setup.sh --flavor prod 의 「사용자 설정 파일」 단계가 이 파일을 ios/Flutter/prod.xcconfig 로 복사하고,
// 뒤 단계가 그 복사본에 값을 채운다(docs/setup.md 「stg · prod 설정」).
// 복사본은 git 에 올라가지 않고 이 예시만 tracked 다 — 본인 값은 복사본에만 넣는다.
// 변수의 뜻은 dev 예시(ios/Flutter/dev.example.xcconfig)와 같고, 값은 prod 의 Firebase 프로젝트 · 콘솔 앱에서 받는다.
// 앱 ID · 표시 이름 — 「앱 정체성」 단계가 복사본에서 맞춘다.
PRODUCT_BUNDLE_IDENTIFIER = com.slimpumpkin.flutterStarterKit
DISPLAY_NAME = Flutter Starter Kit
FLAVOR = prod
// Google 로그인 URL scheme — Google 을 켜면 「Google — iOS 쪽」 단계가 prod 의 iOS 설정 파일 값을 쓴다
// (docs/setup.md 「Google 로그인 켜기」).
REVERSED_CLIENT_ID = com.googleusercontent.apps.YOUR_REVERSED_CLIENT_ID_HERE
// 아래 로그인 수단 키는 flavor 마다 provider 콘솔에 앱을 따로 등록해 받는다.
// ./setup.sh --flavor prod --providers 로 수단을 켜면 수단별 단계가 받은 값을 config/prod.json 과 이 파일에 쓴다
// (docs/setup.md 「Kakao · Naver 는 flavor 마다 새 앱」).
// Facebook App ID · Client Token — config/prod.json 의 facebookAppId · facebookClientToken 과 같은 값.
FACEBOOK_APP_ID = YOUR_FACEBOOK_APP_ID_HERE
FACEBOOK_CLIENT_TOKEN = YOUR_FACEBOOK_CLIENT_TOKEN_HERE
// Kakao 네이티브 앱 키(REST API 키와 다르다) — config/prod.json 의 kakaoNativeAppKey 와 같은 값.
KAKAO_NATIVE_APP_KEY = REPLACE_WITH_PROD_NATIVE_APP_KEY
// Naver 웹 로그인의 콜백 URL scheme(소문자 영숫자) — config/prod.json 의 naverUrlScheme 과 같은 값.
NAVER_URL_SCHEME = your-naver-url-scheme-here
// Naver Client ID · Secret — config/prod.json 의 naverClientId · naverClientSecret 과 같은 값.
// iOS 의 Naver 로그인 plugin 은 앱 시작 때 Info.plist 의 Nid* 키(이 두 값)를 읽으므로 두 파일에 같은 값을 둔다.
NAVER_CLIENT_ID = your-naver-client-id-here
NAVER_CLIENT_SECRET = your-naver-client-secret-here
// LINE Channel ID — config/prod.json 의 lineChannelId 와 같은 값.
LINE_CHANNEL_ID = REPLACE_WITH_PROD_LINE_CHANNEL_ID
// 아래 줄은 Apple Developer Team ID(10자) — 실기기에 설치할 때만 필요하고, 시뮬레이터 빌드는 비워 둬도 된다.
// Xcode > Runner > Signing & Capabilities 의 Team 과 같은 값이다. 비어 있으면 Team ID 가 필요한
// 위저드 단계(Apple 로그인 · App Check — DeviceCheck · APNs 키)가 한 번 묻고 복사본에 쓴다.
DEVELOPMENT_TEAM =
