// stg flavor 공통 변수 (placeholder — 본인 키로 채우기. stg.xcconfig 는 .gitignored)
PRODUCT_BUNDLE_IDENTIFIER = com.slimpumpkin.flutterStarterKit.stg
DISPLAY_NAME = FSK Stg
FLAVOR = stg
REVERSED_CLIENT_ID = com.googleusercontent.apps.YOUR_REVERSED_CLIENT_ID_HERE
FACEBOOK_APP_ID = YOUR_FACEBOOK_APP_ID_HERE
FACEBOOK_CLIENT_TOKEN = YOUR_FACEBOOK_CLIENT_TOKEN_HERE
// Kakao SDK 네이티브 앱 키 (Phase 12 D-20, D-22 — stg 는 사용자 자체 등록). manual.md "## 0. Initial Setup" 절차 참조.
KAKAO_NATIVE_APP_KEY = REPLACE_WITH_STG_NATIVE_APP_KEY
// Naver Login URL scheme (Phase 13 — see ROADMAP.md). stg 는 사용자 자체 등록.
NAVER_URL_SCHEME = your-naver-url-scheme-here
// LINE Channel ID (Phase 14 — see ROADMAP.md, D-LINE-16). stg 는 사용자 자체 등록 (D-LINE-19 일관).
LINE_CHANNEL_ID = REPLACE_WITH_STG_LINE_CHANNEL_ID
// Yahoo!JP Login (Phase 15 — see ROADMAP.md, D-YJP-03). stg 는 사용자 자체 등록 (memory `project_firebase_dev_only` 일관).
YAHOOJP_CLIENT_ID = REPLACE_WITH_STG_YAHOOJP_CLIENT_ID
YAHOOJP_REDIRECT_SCHEME = com.slimpumpkin.flutterStarterKit.stg.yahoojp
